rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
             request.auth.token.email == 'admin@cbcht.com' &&
             request.auth.token.email_verified == true;
    }

    function isValidSermon(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.videoId is string && data.videoId.size() > 0;
    }

    function isValidBlogPost(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.content is string && data.content.size() > 0;
    }

    function isValidContactRequest(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 150 &&
             data.message is string && data.message.size() > 0 && data.message.size() <= 2000;
    }

    // Comprehensive Business Registration Validator for Public Submissions
    function isValidBusinessRegistration(data) {
      let allowedKeys = [
        'name', 'slug', 'ownerName', 'category', 'shortDescription',
        'fullDescription', 'services', 'logo', 'whatsapp', 'phone',
        'email', 'website', 'location', 'instagram', 'facebook',
        'featured', 'status', 'createdAt', 'isChurchMember', 'updatedAt'
      ];

      return data.keys().hasOnly(allowedKeys) &&
             // Mandatory fields
             data.name is string && data.name.size() > 0 && data.name.size() <= 150 &&
             data.slug is string && data.slug.size() > 0 && data.slug.size() <= 160 &&
             data.ownerName is string && data.ownerName.size() > 0 && data.ownerName.size() <= 100 &&
             data.category is string && data.category.size() > 0 && data.category.size() <= 80 &&
             data.shortDescription is string && data.shortDescription.size() > 0 && data.shortDescription.size() <= 350 &&
             data.status == 'pending' &&
             data.featured == false &&
             data.phone is string && data.phone.size() > 0 && data.phone.size() <= 30 &&
             data.whatsapp is string && data.whatsapp.size() > 0 && data.whatsapp.size() <= 30 &&
             data.createdAt is string &&
             // Optional fields validation
             (!('fullDescription' in data) || (data.fullDescription is string && data.fullDescription.size() <= 3000)) &&
             (!('services' in data) || (data.services is list && data.services.size() <= 12)) &&
             (!('logo' in data) || (data.logo is string && data.logo.size() <= 1000)) &&
             (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
             (!('website' in data) || (data.website is string && data.website.size() <= 300)) &&
             (!('location' in data) || (data.location is string && data.location.size() <= 150)) &&
             (!('instagram' in data) || (data.instagram is string && data.instagram.size() <= 150)) &&
             (!('facebook' in data) || (data.facebook is string && data.facebook.size() <= 150));
    }

    // Sermons: Public read, Admin write
    match /sermons/{sermonId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidSermon(request.resource.data);
      allow delete: if isAdmin();
    }

    // Blog Posts: Public read, Admin write
    match /blogPosts/{postId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidBlogPost(request.resource.data);
      allow delete: if isAdmin();
    }

    // Service Times: Public read, Admin write
    match /serviceTimes/{serviceTimeId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Leadership: Public read, Admin write
    match /leadership/{leaderId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Contact Requests: Create only for public, Admin read
    match /contactRequests/{requestId} {
      allow create: if isValidContactRequest(request.resource.data);
      allow read, update, delete: if isAdmin();
    }

    // Gallery: Public read, Admin write
    match /gallery/{groupId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Member Business Directory: Public read published, Public register pending, Admin full control
    match /businesses/{businessId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create: if isValidBusinessRegistration(request.resource.data) || isAdmin();
      allow update, delete: if isAdmin();
    }
  }
}
